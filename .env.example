# Database Secrets
DB_URL=jdbc:postgresql://<database-host>:<port>/<database-name>
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Secret
JWT_SECRET=your_base64_encoded_jwt_secret_key_at_least_256_bits

# Email Secrets
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_email_password

# Supabase Storage Secrets
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=your_supabase_documents_bucket
APP_UPLOAD_DIR=uploads

# Admin Config
ADMIN_EMAILS=admin1@example.com,admin2@example.com
APP_FRONTEND_URL=http://localhost:5173

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gemini Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ONLYOFFICE Secrets
APP_ONLYOFFICE_CALLBACK_URL=http://host.docker.internal:8080/api/onlyoffice/callback
APP_ONLYOFFICE_JWT_SECRET=V8pX9iu5gDWzQrHP5Od62XOOiuOnlrtF
